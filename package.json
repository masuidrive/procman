{
  "name": "@masuidrive/procman",
  "version": "0.1.0",
  "description": "A lightweight process management daemon tool for development environments",
  "type": "module",
  "main": "dist/src/cli/index.js",
  "types": "dist/src/cli/index.d.ts",
  "bin": {
    "procman": "dist/src/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS='--max-old-space-size=1024' vitest",
    "test:run": "NODE_OPTIONS='--max-old-space-size=1024' vitest run",
    "test:limited": "./bin/test-with-memory-limit.sh run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test:run && npm run lint",
    "prepack": "npm run build"
  },
  "keywords": [
    "process-manager",
    "daemon",
    "development",
    "cli",
    "nodejs"
  ],
  "author": "masuidrive",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masuidrive/procman.git"
  },
  "bugs": {
    "url": "https://github.com/masuidrive/procman/issues"
  },
  "homepage": "https://github.com/masuidrive/procman#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/pidusage": "^2.0.5",
    "@types/yaml": "^1.9.6",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "pidusage": "^4.0.1",
    "winston": "^3.17.0",
    "yaml": "^2.8.1"
  }
}
