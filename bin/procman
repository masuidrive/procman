#!/usr/bin/env node

/**
 * procman CLI executable
 * 
 * This script serves as the entry point for the procman CLI tool.
 * It loads the main CLI module and handles process lifecycle.
 */

import('../dist/src/cli/index.js').catch((error) => {
  // Handle module loading errors gracefully
  if (error.code === 'MODULE_NOT_FOUND') {
    console.error('Error: procman has not been built yet.');
    console.error('Please run: npm run build');
    process.exit(1);
  } else {
    console.error('Error loading procman CLI:', error.message);
    process.exit(1);
  }
});